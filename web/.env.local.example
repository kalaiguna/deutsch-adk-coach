# Firebase Web SDK config (from Firebase Console > Project Settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore user ID to read sessions for (matches the Telegram user_id used by the bot)
VITE_FIRESTORE_USER_ID=

# Cloud Function URL for Gemini Live ephemeral token (deploy functions/ first)
VITE_TOKEN_ENDPOINT=
