# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────────

project_id         = "your-gcp-project-id"
billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
region             = "europe-west1"

gemini_api_key     = "AIza..."
telegram_bot_token = "123456:ABC..."
budget_alert_email = "you@example.com"

# Container image built with: gcloud builds submit --tag gcr.io/PROJECT/deutsch-adk-coach
bot_image = "gcr.io/your-gcp-project-id/deutsch-adk-coach:latest"

# GCS bucket for Cloud Function source archive (must be globally unique)
functions_source_bucket = "your-gcp-project-id-cf-source"

# ── Optional ──────────────────────────────────────────────────────────────────

# Required only for /lektuere and /hoeren
google_search_api_key = ""
google_search_cx      = ""

# Comma-separated Telegram user IDs. Leave empty to allow all users.
allowed_telegram_users = ""

# Monthly GCP budget cap in USD. Alerts fire at 50%, 90%, 100%.
monthly_budget_usd = 20

# Gemini model override
gemini_model = "gemini-2.5-flash"
